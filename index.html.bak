<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#0a0a14">
<meta name="description" content="S TV — Бесплатное ТВ и Радио online">
<title>S TV — ТВ и Радио</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%230a0a14'/><text x='50' y='72' text-anchor='middle' font-size='60' font-weight='bold' fill='%2300d4ff'>S</text></svg>">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.7"></script>
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{--bg:#0a0a14;--bg2:#0f0f1a;--card:rgba(255,255,255,0.03);--border:rgba(255,255,255,0.06);--accent:#00d4ff;--radio:#ff5e94;--hd:#00e676;--sd:#ffd600;--fhd:#00e5ff;--text:#fff;--text2:#989899;--text3:#5a5a6e;--r:16px}
html{scroll-behavior:smooth}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;-webkit-font-smoothing:antialiased;overflow-x:hidden}
::-webkit-scrollbar{width:5px}::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.08);border-radius:3px}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
input{font-family:inherit;border:none;outline:none}

/* SPLASH */
#splash{position:fixed;inset:0;z-index:9999;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .6s}
#splash.out{opacity:0;pointer-events:none}
#splashCanvas{position:absolute;inset:0;width:100%;height:100%}
.sp-body{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:12px}
.sp-logo{font-size:72px;font-weight:700;color:var(--accent);text-shadow:0 0 40px rgba(0,212,255,0.5),0 0 80px rgba(0,212,255,0.2);animation:pop .8s cubic-bezier(.34,1.56,.64,1) forwards;transform:scale(0)}
@keyframes pop{to{transform:scale(1)}}
.sp-slogan{font-size:15px;color:var(--text2);font-weight:300;min-height:22px}
.sp-slogan .cur{display:inline-block;width:2px;height:16px;background:var(--accent);vertical-align:text-bottom;animation:blink .6s step-end infinite}
@keyframes blink{50%{opacity:0}}
.sp-dev{position:absolute;bottom:50px;font-size:12px;color:var(--text3);opacity:0;animation:fi .5s .5s forwards}
@keyframes fi{to{opacity:1}}
.sp-bar{position:absolute;bottom:30px;width:200px;height:2px;background:rgba(255,255,255,0.05);border-radius:1px;overflow:hidden}
.sp-fill{height:100%;width:0;background:linear-gradient(90deg,var(--accent),#7B2FFF);transition:width .1s linear}

/* HEADER */
.hdr{position:sticky;top:0;z-index:100;background:rgba(10,10,20,0.88);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:10px 16px;display:flex;align-items:center;gap:10px}
.hdr-logo{font-size:20px;font-weight:700;color:var(--accent);white-space:nowrap}
.hdr-search{flex:1;max-width:360px;position:relative}
.hdr-search input{width:100%;padding:9px 34px 9px 36px;background:var(--bg2);border:1px solid var(--border);border-radius:10px;color:#fff;font-size:13px;transition:border .3s}
.hdr-search input:focus{border-color:var(--accent)}
.hdr-search input::placeholder{color:var(--text3)}
.hdr-search i{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--text3);font-size:13px}
.hdr-x{position:absolute;right:8px;top:50%;transform:translateY(-50%);width:22px;height:22px;border-radius:50%;display:none;align-items:center;justify-content:center;color:var(--text3);font-size:11px}
.hdr-x.on{display:flex}.hdr-x:hover{background:rgba(255,255,255,0.08)}
.hdr-stats{font-size:11px;color:var(--text3);white-space:nowrap}.hdr-stats b{color:var(--accent)}
.hdr-btn{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--text2);font-size:15px;transition:.3s}
.hdr-btn:hover{background:rgba(255,255,255,0.06);color:var(--accent)}
.hdr-btn.spin i{animation:sp 1s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}

/* TABS */
.tabs{display:flex;padding:12px 16px 0;gap:4px}
.tab{flex:1;padding:10px;border-radius:12px;font-size:13px;font-weight:600;text-align:center;background:var(--card);border:1px solid var(--border);transition:.3s}
.tab:hover{border-color:rgba(0,212,255,0.3)}
.tab.on{background:var(--accent);color:#000;border-color:var(--accent)}

/* SCAN */
.scan-w{height:3px;background:var(--bg2);margin:0 16px;border-radius:2px;overflow:hidden;display:none}
.scan-w.on{display:block}
.scan-i{height:100%;width:0;background:linear-gradient(90deg,var(--accent),#7B2FFF);transition:width .15s}
.scan-t{padding:6px 16px;font-size:11px;color:var(--text3);text-align:center;display:none}
.scan-t.on{display:block}

/* CATEGORIES */
.cats{display:flex;gap:6px;padding:10px 16px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.cats::-webkit-scrollbar{display:none}
.cat{padding:7px 14px;border-radius:18px;font-size:12px;font-weight:500;white-space:nowrap;background:var(--card);border:1px solid var(--border);color:var(--text2);transition:.3s;flex-shrink:0}
.cat:hover,.cat.on{background:var(--accent);color:#000;border-color:var(--accent)}

/* GRID */
.main{padding:8px 16px 110px}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}

/* CARD */
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);overflow:hidden;transition:.35s cubic-bezier(.34,1.56,.64,1);cursor:pointer}
.card:hover{transform:translateY(-4px);border-color:var(--accent);box-shadow:0 8px 30px rgba(0,212,255,0.12)}
.card-th{aspect-ratio:16/9;background:var(--bg2);position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}
.card-th::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.04),transparent);animation:shim 2s infinite}
@keyframes shim{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}
.card-th img{width:100%;height:100%;object-fit:contain;position:relative;z-index:1}
.card-q{position:absolute;top:6px;left:6px;padding:2px 7px;border-radius:6px;font-size:9px;font-weight:700;text-transform:uppercase;z-index:2}
.card-q.hd{background:rgba(0,230,118,0.15);color:var(--hd)}
.card-q.sd{background:rgba(255,214,0,0.15);color:var(--sd)}
.card-q.fhd{background:rgba(0,229,255,0.15);color:var(--fhd)}
.card-star{position:absolute;top:6px;right:6px;width:26px;height:26px;border-radius:50%;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--text3);opacity:0;transition:.3s;z-index:2}
.card:hover .card-star{opacity:1}
.card-star.on{color:#ffd600;opacity:1}
.card-body{padding:10px 12px}
.card-name{font-size:12px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:6px}
.card-name mark{background:rgba(0,212,255,0.25);color:#fff;border-radius:2px;padding:0 2px}
.card-cat{font-size:10px;color:var(--text3);margin-bottom:6px}
.card-btn{width:100%;padding:7px;border-radius:8px;font-size:11px;font-weight:600;background:rgba(0,212,255,0.1);color:var(--accent);transition:.3s}
.card-btn:hover{background:var(--accent);color:#000}

/* RADIO CARD */
.card.rc{border-color:rgba(255,94,148,0.12)}
.card.rc:hover{border-color:var(--radio);box-shadow:0 8px 30px rgba(255,94,148,0.12)}
.card.rc .card-th{background:linear-gradient(135deg,rgba(255,94,148,0.08),rgba(123,47,255,0.08))}
.card.rc .card-btn{background:rgba(255,94,148,0.1);color:var(--radio)}
.card.rc .card-btn:hover{background:var(--radio);color:#fff}
.eq{display:flex;gap:3px;align-items:flex-end;height:28px}
.eq i{display:block;width:3px;border-radius:2px;background:var(--radio);transition:height .15s}
.eq i:nth-child(1){height:6px;animation:eq .7s ease-in-out infinite alternate}
.eq i:nth-child(2){height:14px;animation:eq .7s .1s ease-in-out infinite alternate}
.eq i:nth-child(3){height:10px;animation:eq .7s .2s ease-in-out infinite alternate}
.eq i:nth-child(4){height:18px;animation:eq .7s .05s ease-in-out infinite alternate}
.eq i:nth-child(5){height:8px;animation:eq .7s .15s ease-in-out infinite alternate}
@keyframes eq{to{height:4px}}
.card.rc:not(.playing) .eq i{animation-play-state:paused;height:4px}
.card.rc.playing .eq i{animation-play-state:running}
.card.rc:hover .eq i{animation-play-state:running}

/* VIDEO MODAL */
.vid-ov{position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.92);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:.4s;padding:16px}
.vid-ov.on{opacity:1;pointer-events:auto}
.vid-box{width:100%;max-width:900px;background:var(--bg2);border-radius:20px;overflow:hidden;transform:scale(0.85);transition:transform .4s cubic-bezier(.34,1.56,.64,1);position:relative}
.vid-ov.on .vid-box{transform:scale(1)}
.vid-name{position:absolute;top:12px;left:14px;font-size:13px;font-weight:600;color:#fff;background:rgba(0,0,0,0.55);padding:5px 12px;border-radius:8px;z-index:5;pointer-events:none}
.vid-x{position:absolute;top:10px;right:10px;width:34px;height:34px;border-radius:50%;background:rgba(0,0,0,0.6);display:flex;align-items:center;justify-content:center;z-index:5;color:#fff;font-size:14px;transition:.3s}
.vid-x:hover{background:var(--radio)}
.vid-wrap{position:relative;background:#000;aspect-ratio:16/9}
.vid-wrap video{width:100%;height:100%;display:block}

/* AUDIO PLAYER */
.aud-bar{position:fixed;bottom:0;left:0;right:0;z-index:90;background:rgba(10,10,20,0.92);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-top:1px solid rgba(255,94,148,0.15);padding:10px 14px;display:none;align-items:center;gap:10px}
.aud-bar.on{display:flex}
.aud-eq{display:flex;gap:2px;align-items:flex-end;height:22px;min-width:22px}
.aud-eq i{display:block;width:3px;border-radius:2px;background:var(--radio)}
.aud-info{flex:1;min-width:0}
.aud-info .aud-n{font-size:12px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.aud-info .aud-s{font-size:10px;color:var(--radio)}
.aud-play{width:36px;height:36px;border-radius:50%;background:var(--radio);display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;transition:.2s}
.aud-play:hover{transform:scale(1.08)}
.aud-close{color:var(--text3);font-size:16px;padding:4px}

/* SETTINGS */
.sett{display:none;padding:20px 16px 110px}
.sett.on{display:block}
.sett-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:24px}
.sett h2{font-size:20px;font-weight:700;margin-bottom:20px}
.sett-grp{margin-bottom:18px}
.sett-grp h3{font-size:11px;color:var(--text3);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px}
.sett-row{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;background:var(--bg2);border-radius:10px;margin-bottom:6px}
.sett-row label{font-size:13px}
.sett-btn{width:100%;padding:12px;border-radius:10px;font-size:13px;font-weight:500;text-align:center;transition:.3s;margin-bottom:6px}
.sett-btn.primary{background:var(--accent);color:#000}
.sett-btn.danger{background:rgba(255,94,148,0.1);color:var(--radio);border:1px solid rgba(255,94,148,0.2)}
.sett-btn.danger:hover{background:rgba(255,94,148,0.2)}
.sett-dev{text-align:center;margin-top:20px;padding-top:16px;border-top:1px solid var(--border)}
.sett-dev p{font-size:12px;color:var(--text3);margin-bottom:4px}
.sett-dev a{color:var(--accent);font-size:13px}

/* TOAST */
.toast-c{position:fixed;top:16px;right:16px;z-index:9999;display:flex;flex-direction:column;gap:6px}
.toast{padding:10px 18px;background:var(--bg2);border:1px solid var(--border);border-radius:10px;font-size:12px;color:#fff;transform:translateX(120%);transition:transform .4s cubic-bezier(.34,1.56,.64,1);box-shadow:0 6px 24px rgba(0,0,0,0.5)}
.toast.on{transform:translateX(0)}

/* SCROLL TOP */
.to-top{position:fixed;bottom:70px;right:14px;width:40px;height:40px;border-radius:50%;background:var(--accent);color:#000;display:none;align-items:center;justify-content:center;font-size:16px;z-index:50;box-shadow:0 4px 16px rgba(0,212,255,0.3)}
.to-top.on{display:flex}

/* EMPTY */
.empty{text-align:center;padding:50px 16px;color:var(--text3)}
.empty i{font-size:40px;margin-bottom:12px;opacity:.3}
.empty p{font-size:13px}

/* RESPONSIVE */
@media(min-width:500px){.grid{grid-template-columns:repeat(3,1fr)}}
@media(min-width:768px){.grid{grid-template-columns:repeat(4,1fr);gap:12px}.tabs,.cats,.main,.sett{padding-left:24px;padding-right:24px}.hdr{padding:10px 24px}}
@media(min-width:1024px){.grid{grid-template-columns:repeat(5,1fr)}}
@media(min-width:1440px){.grid{grid-template-columns:repeat(6,1fr);max-width:1500px;margin:0 auto}}
</style>
</head>
<body>

<div id="splash">
<canvas id="splashCanvas"></canvas>
<div class="sp-body">
<div class="sp-logo">S TV</div>
<div class="sp-slogan" id="slogan"></div>
<div class="sp-dev">by Safarali Group 🛡</div>
</div>
<div class="sp-bar"><div class="sp-fill" id="sFill"></div></div>
</div>

<header class="hdr">
<div class="hdr-logo">S TV</div>
<div class="hdr-search">
<i class="fas fa-search"></i>
<input id="searchIn" placeholder="Поиск каналов..." autocomplete="off">
<button class="hdr-x" id="searchX" onclick="clearSearch()"><i class="fas fa-times"></i></button>
</div>
<div class="hdr-stats">Каналов: <b id="cntAll">0</b></div>
<button class="hdr-btn" onclick="randomCh()" title="Случайный"><i class="fas fa-dice"></i></button>
<button class="hdr-btn" id="refBtn" onclick="refreshScan()" title="Обновить"><i class="fas fa-sync-alt"></i></button>
</header>

<div class="scan-w" id="scanW"><div class="scan-i" id="scanI"></div></div>
<div class="scan-t" id="scanT"></div>

<div class="tabs">
<button class="tab on" onclick="setTab('tv')">📺 ТВ Каналы</button>
<button class="tab" onclick="setTab('radio')">📻 Радио</button>
<button class="tab" onclick="setTab('settings')">⚙️ Настройки</button>
</div>

<div class="cats" id="catsW"></div>

<main class="main" id="mainW">
<div class="grid" id="grid"></div>
<div class="empty" id="empty" style="display:none"><i class="fas fa-satellite-dish"></i><p>Каналы не найдены</p></div>
</main>

<div class="sett" id="settW">
<div class="sett-card">
<h2>Настройки</h2>
<div class="sett-grp">
<h3>Данные</h3>
<button class="sett-btn primary" onclick="refreshScan();setTab('tv')">🔄 Обновить каналы</button>
<button class="sett-btn danger" onclick="clearCache()">🗑 Очистить кеш</button>
</div>
<div class="sett-grp">
<h3>Информация</h3>
<div class="sett-row"><label>Версия</label><span style="color:var(--text2);font-size:12px">1.0.0</span></div>
<div class="sett-row"><label>Разработчик</label><span style="color:var(--text2);font-size:12px">Safarali Group 🛡</span></div>
</div>
<div class="sett-dev">
<a href="https://t.me/Mushtariy_LLC" target="_blank"><i class="fab fa-telegram"></i> Telegram @Mushtariy_LLC</a>
<p style="margin-top:8px"><button onclick="shareApp()" style="color:var(--accent);font-size:13px">📤 Поделиться</button></p>
</div>
</div>
</div>

<div class="vid-ov" id="vidOv">
<div class="vid-box">
<div class="vid-name" id="vidName"></div>
<button class="vid-x" onclick="closeVid()"><i class="fas fa-times"></i></button>
<div class="vid-wrap" id="vidWrap">
<video id="video" playsinline controls></video>
</div>
</div>
</div>

<div class="aud-bar" id="audBar">
<div class="aud-eq" id="audEq"><i></i><i></i><i></i><i></i><i></i></div>
<div class="aud-info">
<div class="aud-n" id="audName">...</div>
<div class="aud-s">● LIVE</div>
</div>
<button class="aud-play" id="audPlay" onclick="toggleAud()"><i class="fas fa-pause"></i></button>
<button class="aud-close" onclick="closeAud()"><i class="fas fa-times"></i></button>
</div>

<div class="toast-c" id="toastC"></div>
<button class="to-top" id="toTop" onclick="scrollTo({top:0,behavior:'smooth'})"><i class="fas fa-chevron-up"></i></button>

<audio id="audEl" crossorigin="anonymous"></audio>

<script>
(function(){
'use strict';

// ===== SECURE STORAGE — URLs ONLY in JS memory =====
var _ch = [];       // [{name, url, logo, cat, q, t}]  t='tv'|'r'
var _tvIdx = [];
var _radIdx = [];
var _favIdx = [];
var _tab = 'tv';
var _cat = 'all';
var _q = '';
var _scanning = false;
var _curIdx = -1;
var _hls = null;
var _audioCtx = null;
var _animF = null;

var API_STREAMS = 'https://iptv-org.github.io/api/streams.json';
var API_CHANNELS = 'https://iptv-org.github.io/api/channels.json';

var $ = function(s){ return document.querySelector(s); };
var $$ = function(s){ return document.querySelectorAll(s); };

// ===== SPLASH =====
(function(){
var cv = $('#splashCanvas'), cx = cv.getContext('2d');
var stars = [], mx = 0, my = 0;
function rs(){ cv.width = innerWidth; cv.height = innerHeight; }
rs(); addEventListener('resize', rs);
for(var i=0;i<180;i++) stars.push({x:Math.random()*cv.width,y:Math.random()*cv.height,r:Math.random()*1.4+.3,vx:(Math.random()-.5)*.25,vy:(Math.random()-.5)*.25,a:Math.random()});
addEventListener('mousemove',function(e){mx=(e.clientX/cv.width-.5)*15;my=(e.clientY/cv.height-.5)*15});
function draw(){cx.clearRect(0,0,cv.width,cv.height);for(var i=0;i<stars.length;i++){var s=stars[i];s.x+=s.vx;s.y+=s.vy;if(s.x<0)s.x=cv.width;if(s.x>cv.width)s.x=0;if(s.y<0)s.y=cv.height;if(s.y>cv.height)s.y=0;cx.beginPath();cx.arc(s.x+mx*s.a,s.y+my*s.a,s.r,0,6.28);cx.fillStyle='rgba(255,255,255,'+(0.25+s.a*0.5)+')';cx.fill()}requestAnimationFrame(draw)}
draw();
var sl='ТВ и Радио — всегда под рукой',el=$('#slogan'),si=0;
function tc(){if(si<sl.length){el.innerHTML=sl.slice(0,si+1)+'<span class="cur"></span>';si++;setTimeout(tc,55)}else el.innerHTML=sl+'<span class="cur"></span>'}
setTimeout(tc,900);
var p=0,fl=$('#sFill');
var iv=setInterval(function(){p+=Math.random()*12+3;if(p>=100){p=100;clearInterval(iv);setTimeout(function(){$('#splash').classList.add('out');setTimeout(function(){$('#splash').remove();init()},600)},250)}fl.style.width=p+'%'},100);
})();

// ===== INIT =====
function init(){
loadFav();
setupSearch();
setupScroll();
addEventListener('keydown',function(e){if(e.key==='Escape')closeVid()});
var cached=localStorage.getItem('stv_cache2');
var ct=parseInt(localStorage.getItem('stv_ct2')||'0');
if(cached&&Date.now()-ct<864e5){
try{_ch=JSON.parse(cached)}catch(e){_ch=[]}
buildIdx();render();renderCats();
}else{
doScan();
}
}

function buildIdx(){
_tvIdx=[];_radIdx=[];
for(var i=0;i<_ch.length;i++){if(_ch[i].t==='tv')_tvIdx.push(i);else _radIdx.push(i)}
$('#cntAll').textContent=_ch.length;
}

// ===== CATEGORIES =====
var TV_C=['all','news','movies','sports','kids','music','education','general','religious','regional'];
var TV_L=['🔥 Все','📰 Новости','🎬 Фильмы','⚽ Спорт','👶 Дети','🎵 Музыка','📚 Общие','📺 Общие','⛪ Религия','🌍 Регионы'];
var R_C=['all','music','talk','regional'];
var R_L=['🔥 Все','🎵 Музыка','📡 Разговорное','🌐 Регионы'];

var CAT_MAP={
'news':'news','movies':'movies','sports':'sports','kids':'kids','music':'music',
'education':'education','general':'general','religious':'religious','regional':'regional',
'entertainment':'general','comedy':'general','documentary':'general','weather':'news',
'bust':'general','food':'general','outdoor':'general','travel':'general','shopping':'general',
'xxx':null
};

function matchC(ch,c){
if(c==='all')return true;
var cats=ch.cat||[];
var target=CAT_MAP[c]||c;
for(var i=0;i<cats.length;i++){if(cats[i]===target)return true}
return false;
}

function renderCats(){
var cs=_tab==='radio'?R_C:TV_C;
var ls=_tab==='radio'?R_L:TV_L;
var h='';
for(var i=0;i<cs.length;i++){
h+='<button class="cat'+(cs[i]===_cat?' on':'')+'" onclick="window._sc(\''+cs[i]+'\')">'+ls[i]+'</button>';
}
$('#catsW').innerHTML=h;
}
window._sc=function(c){_cat=c;renderCats();render()};

function getFiltered(){
var idxs=_tab==='radio'?_radIdx:_tvIdx;
var result=[];
for(var i=0;i<idxs.length;i++){
var ch=_ch[idxs[i]];
if(_q&&ch.name.toLowerCase().indexOf(_q.toLowerCase())<0)continue;
if(!matchC(ch,_cat))continue;
result.push(idxs[i]);
}
return result;
}

function hl(t){
if(!q)return t;
var re=new RegExp('('+_q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+')','gi');
return t.replace(re,'<mark>$1</mark>');
}

function render(){
var g=$('#grid'),em=$('#empty');
if(_tab==='settings'){$('#mainW').style.display='none';$('#settW').classList.add('on');$('#catsW').style.display='none';return}
$('#mainW').style.display='';$('#settW').classList.remove('on');$('#catsW').style.display='';

var filtered=getFiltered();
if(!filtered.length){g.innerHTML='';em.style.display='';em.querySelector('p').textContent='Каналы не найдены';return}
em.style.display='none';
g.innerHTML=filtered.map(function(idx){return makeCard(idx)}).join('');
}

function makeCard(idx){
var ch=_ch[idx];
var isFav=_favIdx.indexOf(idx)>=0;
var isR=ch.t==='r';
var qc=ch.q?'<span class="card-q '+ch.q+'">'+ch.q.toUpperCase()+'</span>':'';
var logoHtml=ch.logo?'<img src="'+ch.logo+'" alt="" loading="lazy" onerror="this.style.display=\'none\'">':'<div class="eq"><i></i><i></i><i></i><i></i><i></i></div>';
var catLabel=ch.cat&&ch.cat[0]?ch.cat[0]:'';
return'<div class="card'+(isR?' rc':'')+'" data-i="'+idx+'">'+
'<div class="card-th">'+qc+logoHtml+
'<span class="card-star'+(isFav?' on':'')+'" data-f="'+idx+'"><i class="'+(isFav?'fas':'far')+' fa-star"></i></span></div>'+
'<div class="card-body"><div class="card-name">'+ch.name+'</div>'+
(catLabel?'<div class="card-cat">'+catLabel+'</div>':'')+
'<button class="card-btn" data-p="'+idx+'">'+(isR?'▶ Слушать':'▶ Смотреть')+'</button></div></div>';
}

// ===== SCANNER =====
function doScan(){
if(_scanning)return;
_scanning=true;
$('#scanW').classList.add('on');
$('#scanT').classList.add('on');
$('#refBtn').classList.add('spin');
$('#scanT').textContent='Загрузка списка каналов...';
$('#scanI').style.width='10%';

// Fetch channels and streams in parallel
Promise.all([
fetch(API_CHANNELS).then(function(r){return r.json()}),
fetch(API_STREAMS).then(function(r){return r.json()})
]).then(function(data){
var channels=data[0];
var streams=data[1];
$('#scanI').style.width='50%';
$('#scanT').textContent='Обработка '+channels.length+' каналов...';

// Build streams lookup by channel ID
var streamMap={};
for(var i=0;i<streams.length;i++){
var s=streams[i];
if(s.channel&&s.url){
// Keep only first stream per channel
if(!streamMap[s.channel]){
streamMap[s.channel]={url:s.url,quality:s.quality||''};
}
}
}

// Build channel list
_ch=[];
var radioKeywords=['radio','fm','musica','music'];
for(var i=0;i<channels.length;i++){
var ch=channels[i];
var st=streamMap[ch.id];
if(!st)continue;

var name=ch.name||ch.id;
var isRadio=false;
var nameLow=name.toLowerCase();
for(var j=0;j<radioKeywords.length;j++){
if(nameLow.indexOf(radioKeywords[j])>=0){isRadio=true;break}
}
// Also check categories
if(ch.categories){
for(var j=0;j<ch.categories.length;j++){
if(ch.categories[j]==='radio'){isRadio=true;break}
}
}

var q='';
var ql=(st.quality||'').toLowerCase();
if(ql.indexOf('1080')>=0||ql.indexOf('fhd')>=0)q='fhd';
else if(ql.indexOf('720')>=0||ql.indexOf('hd')>=0)q='hd';
else if(ql.indexOf('480')>=0||ql.indexOf('sd')>=0)q='sd';

var logo='';
if(ch.id){
logo='https://iptv-org.github.io/api/logo/'+encodeURIComponent(ch.id)+'.png';
}

_ch.push({
name:name,
url:st.url,
logo:logo,
cat:ch.categories||[],
q:q,
t:isRadio?'r':'tv'
});
}

$('#scanI').style.width='80%';
$('#scanT').textContent='Сохранение...';

buildIdx();
render();
renderCats();

// Cache WITHOUT URLs
var safe=_ch.map(function(c){return{name:c.name,logo:c.logo,cat:c.cat,q:c.q,t:c.t}});
localStorage.setItem('stv_cache2',JSON.stringify(safe));
localStorage.setItem('stv_ct2',Date.now().toString());

$('#scanW').classList.remove('on');
$('#scanT').classList.remove('on');
$('#refBtn').classList.remove('spin');
$('#scanT').textContent='Готово! Каналов: '+_ch.length;
_scanning=false;
}).catch(function(err){
console.error('Scan error:',err);
$('#scanT').textContent='Ошибка загрузки: '+err.message;
$('#scanW').classList.remove('on');
$('#refBtn').classList.remove('spin');
_scanning=false;
});
}

function refreshScan(){
localStorage.removeItem('stv_cache2');
localStorage.removeItem('stv_ct2');
_ch=[];
buildIdx();
render();
doScan();
setTab('tv');
toast('🔄 Каналы обновляются...');
}

function clearCache(){
localStorage.removeItem('stv_cache2');
localStorage.removeItem('stv_ct2');
_ch=[];_tvIdx=[];_radIdx=[];
render();
toast('🗑 Кеш очищен');
doScan();
}

// ===== VIDEO PLAYER — URL ONLY as function argument =====
function openVid(idx){
if(idx<0||idx>=_ch.length)return;
_curIdx=idx;
var ch=_ch[idx];
$('#vidName').textContent=ch.name;
$('#vidOv').classList.add('on');
document.body.style.overflow='hidden';
var v=$('#video');
if(_hls){_hls.destroy();_hls=null}

// URL from memory, passed directly — local variable, gone after function
var url=ch.url;

if(url.indexOf('.m3u8')>=0){
if(Hls.isSupported()){
_hls=new Hls();
_hls.loadSource(url);
_hls.attachMedia(v);
_hls.on(Hls.Events.MANIFEST_PARSED,function(){v.play().catch(function(){})});
}else if(v.canPlayType('application/vnd.apple.mpegurl')){
v.src=url;v.play().catch(function(){});
}
}else{
v.src=url;v.play().catch(function(){});
}
}

function closeVid(){
$('#vidOv').classList.remove('on');
document.body.style.overflow='';
var v=$('#video');v.pause();v.removeAttribute('src');
if(_hls){_hls.destroy();_hls=null}
_curIdx=-1;
}

// ===== AUDIO PLAYER — URL ONLY as function argument =====
function openAud(idx){
if(idx<0||idx>=_ch.length)return;
_curIdx=idx;
var ch=_ch[idx];
var a=$('#audEl');
if(_audioCtx){_audioCtx.close();_audioCtx=null}

var url=ch.url;

if(url.indexOf('.m3u8')>=0){
if(Hls.isSupported()){
var ah=new Hls();
ah.loadSource(url);ah.attachMedia(a);
ah.on(Hls.Events.MANIFEST_PARSED,function(){a.play().catch(function(){})});
window._ah=ah;
}else{a.src=url;a.play().catch(function(){})}
}else{a.src=url;a.play().catch(function(){})}

$('#audName').textContent=ch.name;
$('#audBar').classList.add('on');
$('#audPlay').innerHTML='<i class="fas fa-pause"></i>';
setupEq();
render();
}

function toggleAud(){
var a=$('#audEl');a.paused?a.play():a.pause();
$('#audPlay').innerHTML=a.paused?'<i class="fas fa-play"></i>':'<i class="fas fa-pause"></i>';
}

function closeAud(){
var a=$('#audEl');a.pause();a.removeAttribute('src');
if(window._ah){window._ah.destroy();window._ah=null}
if(_audioCtx){_audioCtx.close();_audioCtx=null}
cancelAnimationFrame(_animF);
$('#audBar').classList.remove('on');
_curIdx=-1;render();
}

function setupEq(){
try{
_audioCtx=new(window.AudioContext||window.webkitAudioContext)();
var an=_audioCtx.createAnalyser();an.fftSize=64;
var src=_audioCtx.createMediaElementSource($('#audEl'));
src.connect(an);an.connect(_audioCtx.destination);
var bars=$$('#audEq i');var d=new Uint8Array(an.frequencyBinCount);
function animate(){an.getByteFrequencyData(d);for(var i=0;i<bars.length;i++)bars[i].style.height=Math.max(3,d[i*2]/255*22)+'px';_animF=requestAnimationFrame(animate)}
animate();
}catch(e){}
}

// ===== DELEGATION — NO URL IN DOM =====
document.addEventListener('click',function(e){
var t=e.target;
var pb=t.closest('[data-p]');
if(pb){e.stopPropagation();var i=parseInt(pb.getAttribute('data-p'));_tab==='radio'?openAud(i):openVid(i);return}
var fb=t.closest('[data-f]');
if(fb){e.stopPropagation();toggleFav(parseInt(fb.getAttribute('data-f')));return}
var cd=t.closest('.card[data-i]');
if(cd){var ci=parseInt(cd.getAttribute('data-i'));_tab==='radio'?openAud(ci):openVid(ci);return}
if(t===$('#vidOv'))closeVid();
});

// ===== FAVORITES — indices only =====
function loadFav(){try{_favIdx=JSON.parse(localStorage.getItem('stv_fav2')||'[]')}catch(e){_favIdx=[]}}
function saveFav(){localStorage.setItem('stv_fav2',JSON.stringify(_favIdx));render()}
function toggleFav(idx){
var i=_favIdx.indexOf(idx);
if(i>=0){_favIdx.splice(i,1);toast('🗑 Удалено из избранного')}
else{_favIdx.push(idx);toast('⭐ Добавлено в избранное')}
saveFav();
}

// ===== SEARCH =====
function setupSearch(){$('#searchIn').addEventListener('input',function(e){_q=e.target.value.trim();$('#searchX').classList.toggle('on',_q.length>0);render()})}
function clearSearch(){$('#searchIn').value='';_q='';$('#searchX').classList.remove('on');render()}

// ===== TABS =====
function setTab(t){
_tab=t;_cat='all';
var tabs=$$('.tab');
for(var i=0;i<tabs.length;i++){tabs[i].classList.remove('on');if((t==='tv'&&i===0)||(t==='radio'&&i===1)||(t==='settings'&&i===2))tabs[i].classList.add('on')}
renderCats();render();
}
window.setTab=setTab;

// ===== UTILS =====
function toast(m){var d=document.createElement('div');d.className='toast';d.textContent=m;$('#toastC').appendChild(d);requestAnimationFrame(function(){d.classList.add('on')});setTimeout(function(){d.classList.remove('on');setTimeout(function(){d.remove()},400)},3000)}
function setupScroll(){addEventListener('scroll',function(){var t=$('#toTop');if(t)t.classList.toggle('on',scrollY>350)})}
function randomCh(){var idxs=_tab==='radio'?_radIdx:_tvIdx;if(!idxs.length){toast('Нет каналов');return}var r=idxs[Math.floor(Math.random()*idxs.length)];_tab==='radio'?openAud(r):openVid(r);toast('🎲 '+_ch[r].name)}
function shareApp(){if(navigator.share)navigator.share({title:'S TV — ТВ и Радио',url:location.href});else navigator.clipboard.writeText(location.href).then(function(){toast('✅ Ссылка скопирована!')})}

})();
</script>
</body>
</html>